  "author": "DOZZIcs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DOZZIcs/lmstudio-web-search.git"
  },
  "bugs": {
    "url": "https://github.com/DOZZIcs/lmstudio-web-search/issues"
  },
  "homepage": "https://github.com/DOZZIcs/lmstudio-web-search#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@lmstudio/sdk": "1.4.0",
